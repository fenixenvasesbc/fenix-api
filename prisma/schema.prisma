generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES
  SALES_MANAGER
  ADMINISTRATION
  FACTORY
  FACTORY_MANAGER
  CLICHE_OPERATOR
  // Rol nuevo: ve todo lo que ve ADMIN (via ROLE_INHERITANCE en RolesGuard)
  // y ademas es el UNICO que puede configurar LabelMessageRule (ADMIN queda
  // excluido de esa configuracion a proposito, por pedido explicito).
  SUPPORT
  // ADR-004: modulo de solicitudes de bocetos. Ambos roles tienen su acceso
  // limitado UNICAMENTE a ese modulo (sin chats/leads/resto de Fenix) -- la
  // restriccion se aplica en la SPA, no en RolesGuard (que solo sabe de
  // "puede/no puede" una ruta puntual).
  DESIGNER
  DESIGNER_MANAGER
}

enum EmployeeContractType {
  FIJO
  POR_HORAS
}

enum TimeEntryRateType {
  OVERTIME_WEEKDAY
  OVERTIME_SATURDAY
  OVERTIME_SUNDAY
  OVERTIME_HOLIDAY
  HOURLY
}

enum HolidayScope {
  NATIONAL
  REGIONAL
  LOCAL
}

enum ClicheCategory {
  ENVIO
  COMBO
  HAMBURGUESA
  PIZZA
  LONCHEADO
  SOBRES
  BOLSAS
  VASOS
  TARTAS
}

enum LeadStatus {
  NEW // creado/confirmado al aceptar el primer envío
  RESPONDED // cuando llega el primer inbound (de cualquier tipo)
  // luego: WAITING_SKETCH, IN_PRODUCTION, CLOSED_WON, etc.
}

// Catalogo GLOBAL de labels de lead (antes enum LeadLabel, luego una copia
// por Account): una sola definicion compartida por todas las cuentas. Editar
// una label (nombre, umbral de alerta, activar/desactivar) o crear una
// custom afecta a todo el sistema, no a una cuenta en particular.
model LeadLabelDefinition {
  id    String  @id @default(uuid())
  code  String // identificador estable (ej. PRODUCCION, REPETICIONES, o slug para labels custom)
  name  String
  color String?

  // Las 6 labels originales (antes enum LeadLabel) se sembraron como sistema:
  // no se pueden borrar, pero su nombre/color/umbral de alerta si son editables.
  // REPETICIONES es especial: la usa tambien el job de recordatorios de WhatsApp
  // (RepetitionReminderScheduler/Dispatch), asi que su "code" nunca debe cambiar.
  isSystem Boolean @default(false)

  // Dias que un lead puede permanecer en esta label antes de generar una
  // AppNotification (sistema de alertas in-app). null = sin alerta configurada.
  // Esto NO tiene relacion con el envio automatico de mensajes de WhatsApp.
  alertThresholdDays Int?

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code])
  @@index([active, sortOrder])
}

enum AppNotificationType {
  LABEL_STALE
  // ADR-004: se dispara cuando un DesignRequest llega a la columna isFinal
  // ("Boceto terminado"), para avisar a la comercial creadora.
  DESIGN_REQUEST_READY
  // ADR-004 Submodulo 6: se dispara cuando una solicitud se envia de
  // "Terminado" a "Modificacion" (ver sendToModification()).
  DESIGN_REQUEST_SENT_TO_MODIFICATION
  // ADR-004 Submodulo 6: se dispara con cada comentario nuevo en una
  // solicitud, hacia "la otra parte" (ver ADR SS9.8).
  DESIGN_REQUEST_COMMENTED
}

enum AppNotificationStatus {
  UNREAD
  READ
}

enum AppNotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AssistantSessionMode {
  INTERNAL_FAQ
}

enum AssistantMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AssistantMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AssistantFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum AssistantFeedbackReviewStatus {
  PENDING
  ANNOTATED
  DISMISSED
}

enum AssistantAuditAction {
  QUERY
  FEEDBACK
  KNOWLEDGE_UPLOAD
  KNOWLEDGE_LIST
  KNOWLEDGE_PROCESS
  KNOWLEDGE_APPROVE
  KNOWLEDGE_DISCARD
  KNOWLEDGE_DOCUMENT_STATUS
  FEEDBACK_ANNOTATE
  FEEDBACK_DISMISS
}

enum AssistantKnowledgeImportStatus {
  PENDING_APPROVAL
  APPROVED
  DISCARDED
  NEEDS_MANUAL_REVIEW
  FAILED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageType {
  TEMPLATE
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  UNKNOWN
}

enum MessageStatus {
  ACCEPTED // lo que llega en envío: "accepted"
  SENT
  DELIVERED
  READ
  FAILED
  UNKNOWN
}

model User {
  id                        String                     @id @default(uuid())
  email                     String                     @unique
  passwordHash              String
  role                      Role                       @default(SALES)
  isActive                  Boolean                    @default(true) // Un SALES puede tener (como máximo) 1 cuenta. // ADMIN normalmente lo tendrá null. 
  accountId                 String?                    @unique
  account                   Account?                   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  refreshTokens             RefreshToken[]
  passwordResetTokens       PasswordResetToken[]
  assistantSessions         AssistantSession[]
  assistantMessages         AssistantMessage[]
  assistantFeedback         AssistantFeedback[]
  assistantFeedbackReviews  AssistantFeedback[] @relation("AssistantFeedbackReviewedBy")
  createdGlobalWhatsappTemplates GlobalWhatsappTemplate[]
  createdLabelMessageRules  LabelMessageRule[]
  assistantAuditEvents      AssistantAuditEvent[]
  assistantKnowledgeImports AssistantKnowledgeImport[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([role])
  @@index([isActive])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Cliche {
  id       String         @id @default(uuid())
  name     String
  category ClicheCategory
  letter   String
  year     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, year])
  @@index([name])
  @@index([letter])
  @@index([createdAt])
}

model Account {
  id   String @id @default(uuid())
  name String

  // Identificadores YCloud para multi-cuenta
  wabaId    String
  phoneE164 String // ejemplo: +34645730616

  // Relación 1-1 inversa con User (SALES)
  user User?

  // Una cuenta puede tener múltiples leads o ninguno
  leads    Lead[]
  // Una cuenta puede tener múltiples mensajes o ninguno
  messages Message[]

  webhookEvents       WebhookEvent[]
  providerCredentials AccountProviderCredential[]
  designRequests      DesignRequest[] // ADR-004

  leadCampaigns             LeadCampaign[]
  campaignTemplates         AccountCampaignTemplate[]
  globalWhatsappTemplateAccounts GlobalWhatsappTemplateAccount[]
  leadLabelHistory          LeadLabelHistory[]
  leadLabelAssignments      LeadLabelAssignment[]
  repetitionReminders       LeadRepetitionReminder[]
  notifications             AppNotification[]
  mediaUploads              MediaUpload[]
  assistantSessions         AssistantSession[]
  assistantAuditEvents      AssistantAuditEvent[]
  assistantKnowledgeImports AssistantKnowledgeImport[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  // Unicidad: una cuenta se identifica por wabaId + teléfono
  @@unique([wabaId, phoneE164])
  @@index([phoneE164])
  @@index([wabaId])
}

model Lead {
  id                   String     @id @default(uuid())
  name                 String?
  ycloudNickname       String?
  whatsappContactName  String?
  whatsappProfileName  String?
  // Override manual: cuando un comercial edita el nombre del lead desde
  // la SPA, se guarda aqui y tiene prioridad MAXIMA en resolveLeadDisplayName
  // (por encima de los nombres que vienen de WhatsApp/YCloud), porque es una
  // correccion explicita hecha a mano.
  manualName           String?
  manualNameSetByUserId String?
  manualNameSetAt      DateTime?
  phoneE164            String
  email                String?
  status               LeadStatus @default(NEW)
  // Identificadres nuevos para correlación con YCloud/WhatsApp 29/30/2026
  whatsappUserId       String?
  whatsappParentUserId String?
  whatsappUsername     String?

  firstOutboundAt           DateTime? // se setea cuando aceptan el 1er envío
  firstInboundAt            DateTime? // se setea cuando llega el 1er inbound
  firstOutboundTemplateName String? // para métrica #1, se setea con el template del 1er envío

  preferredLanguage  String? // para guardar el idioma preferido del cliente, si viene en el payload de YCloud (ejemplo: outbound.template.language.code o inbound.message.text.language)
  lastInboundAt      DateTime? // se actualiza cada vez que llega un inbound
  lastOutboundAt     DateTime? // se actualiza cada vez que se envía un mensaje
  respondedAt        DateTime? // se setea con el timestamp del primer inbound (si no se ha seteado antes)
  lastMessageAt      DateTime? // se actualiza con el timestamp de cada mensaje (inbound o outbound)
  sourceTemplateName String? // se setea con el template del primer mensaje (inbound o outbound) para métrica #2

  currentLabel             String?
  currentLabelChangedAt    DateTime?
  repetitionReminderDays   Int?
  nextRepetitionReminderAt DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  reengagementSentAt DateTime? // se setea cuando se envía un mensaje de reengagement (ejemplo: plantilla de "te seguimos esperando")

  // Lead asociado a una cuenta (0..N por cuenta)
  accountId String?
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  messages  Message[]

  webhookEvents       WebhookEvent[]
  leadCampaigns       LeadCampaign[]
  conversations       Conversation[]
  labelHistory        LeadLabelHistory[]
  labelAssignments    LeadLabelAssignment[]
  repetitionReminders LeadRepetitionReminder[]
  notifications       AppNotification[]
  assistantSessions   AssistantSession[]
  designRequests      DesignRequest[] // ADR-004

  @@unique([accountId, phoneE164])
  @@index([accountId])
  @@index([phoneE164])
  @@index([email])
  @@index([firstInboundAt])
  @@index([accountId, firstOutboundAt])
  @@index([firstOutboundTemplateName])
  @@index([accountId, status, createdAt])
  @@index([accountId, lastInboundAt])
  @@index([accountId, lastOutboundAt])
  @@index([accountId, currentLabel, updatedAt])
  @@index([accountId, nextRepetitionReminderAt])
  @@index([createdAt])
}

model LeadLabelHistory {
  id              String     @id @default(uuid())
  leadId          String
  accountId       String
  fromLabel       String?
  toLabel         String
  changedAt       DateTime   @default(now())
  changedByUserId String?

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, toLabel, changedAt])
  @@index([leadId, changedAt])
}

model LeadLabelAssignment {
  id               String    @id @default(uuid())
  leadId           String
  accountId        String
  label            String
  assignedAt       DateTime  @default(now())
  assignedByUserId String?
  removedAt        DateTime?
  removedByUserId  String?
  reason           String?
  metadata         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  repetitionReminders LeadRepetitionReminder[]

  @@index([accountId, label, removedAt, assignedAt])
  @@index([leadId, removedAt])
  @@index([leadId, label])
}

model LeadRepetitionReminder {
  id                String  @id @default(uuid())
  leadId            String
  accountId         String
  labelHistoryId    String?
  labelAssignmentId String?

  markedAt     DateTime
  dueAt        DateTime
  reminderDays Int

  sentAt     DateTime?
  canceledAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead            Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  account         Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  labelAssignment LeadLabelAssignment? @relation(fields: [labelAssignmentId], references: [id], onDelete: SetNull)

  @@index([accountId, dueAt, sentAt, canceledAt])
  @@index([leadId, markedAt])
  @@index([labelHistoryId])
  @@index([labelAssignmentId])
}

model AppNotification {
  id        String  @id @default(uuid())
  accountId String
  leadId    String?

  type     AppNotificationType
  status   AppNotificationStatus   @default(UNREAD)
  severity AppNotificationSeverity @default(WARNING)

  dedupeKey String
  title     String
  message   String
  label     String?

  triggeredAt DateTime  @default(now())
  readAt      DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([accountId, dedupeKey])
  @@index([accountId, status, triggeredAt])
  @@index([accountId, type, status])
  @@index([leadId, type, status])
}

model AssistantSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  mode                   AssistantSessionMode @default(INTERNAL_FAQ)
  title                  String?
  provider               String               @default("DIFY")
  providerConversationId String?

  messages AssistantMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([leadId, createdAt])
  @@index([providerConversationId])
}

model AssistantMessage {
  id String @id @default(uuid())

  sessionId String
  session   AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  role   AssistantMessageRole
  status AssistantMessageStatus @default(COMPLETED)

  content String

  providerMessageId String?
  providerTaskId    String?
  model             String?
  latencyMs         Int?
  usage             Json?
  rawPayload        Json?
  errorCode         String?
  errorMessage      String?

  citations AssistantCitation[]
  feedback  AssistantFeedback[]

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([providerMessageId])
}

model AssistantCitation {
  id String @id @default(uuid())

  messageId String
  message   AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  providerResourceId String?
  datasetId          String?
  documentId         String?
  documentName       String?
  segmentId          String?
  score              Decimal? @db.Decimal(10, 6)
  excerpt            String?
  metadata           Json?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([datasetId, documentId])
}

model AssistantFeedback {
  id String @id @default(uuid())

  messageId String
  message   AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating     AssistantFeedbackRating
  reason     String?
  editedText String?

  status           AssistantFeedbackReviewStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedByUser   User?                          @relation("AssistantFeedbackReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  difyAnnotationId String?

  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@index([rating, status, createdAt])
}

model AssistantAuditEvent {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  action    AssistantAuditAction
  success   Boolean              @default(true)
  latencyMs Int?

  provider     String? @default("DIFY")
  providerId   String?
  errorCode    String?
  errorMessage String?
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
  @@index([accountId, action, createdAt])
  @@index([success, createdAt])
}

model AssistantKnowledgeImport {
  id                       String                         @id @default(uuid())
  userId                   String
  user                     User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId                String?
  account                  Account?                       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  datasetId                String
  datasetName              String
  documentName             String
  sourceFileName           String
  sourceMimeType           String
  sourceSizeBytes          Int
  markdown                 String
  validationPoints         Json
  status                   AssistantKnowledgeImportStatus @default(PENDING_APPROVAL)
  difyDocumentId           String?
  difyBatch                String?
  replacesDifyDocumentId   String?
  replacesDifyDocumentName String?
  replacementAction        String?
  newDocumentEnabledAt     DateTime?
  replacementError         String?
  difyResponse             Json?
  errorMessage             String?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  approvedAt               DateTime?
  discardedAt              DateTime?

  @@index([userId])
  @@index([accountId])
  @@index([datasetId])
  @@index([status])
  @@index([createdAt])
}

model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  revokedAt DateTime?
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Message {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  direction MessageDirection
  type      MessageType

  // IDs de YCloud/WhatsApp para correlación
  ycloudMessageId String? // outbound: response.id, inbound: whatsappInboundMessage.id
  wamid           String? // wamid.HBg...
  contextWamid    String? // inbound.context.id (si viene)

  // 🔥 NUEVO (INBOUND)
  senderWhatsAppUserId String?
  senderParentUserId   String?

  // 🔥 NUEVO (OUTBOUND / UPDATED)
  recipientWhatsAppUserId String?
  recipientParentUserId   String?

  // 🔥 NUEVO (perfil)
  customerUsername    String?
  customerDisplayName String?

  // Campaña/plantilla para métrica #1
  templateName    String? // outbound.template.name
  templateLang    String? // outbound.template.language.code
  pricingCategory String? // outbound.pricingCategory (opcional)
  // coste por mensaje (lo que te manda YCloud)
  totalPrice      Decimal?      @db.Decimal(12, 6)
  currency        String? // outbound.pricingCurrency
  status          MessageStatus @default(UNKNOWN)

  // timestamps del proveedor
  providerCreateTime DateTime? // outbound.createTime o inbound.createTime
  providerUpdateTime DateTime? // outbound.updateTime
  providerSendTime   DateTime? // inbound.sendTime (si aplica)

  updatedAt DateTime @updatedAt // para saber cuándo se actualizó el status por última vez

  // contenido (opcional ahora, útil luego)
  textBody           String? // inbound.text.body si type=TEXT
  mediaUrl           String? // para image/video/document (si luego lo necesitas)
  caption            String?
  mimeType           String?
  fileName           String?
  mediaOriginalUrl   String?
  mediaStorageDriver String?
  mediaStorageKey    String?
  mediaSizeBytes     Int?
  mediaStoredAt      DateTime?
  mediaExpiresAt     DateTime?
  mediaExpiredAt     DateTime?
  errors             Json?
  interactivePayload Json?

  // debug/auditoría
  rawPayload Json? // guardas el payload entero por si mañana necesitas campos

  createdAt DateTime @default(now())

  externalId               String?   @unique
  clientRequestId          String?
  deletedAt                DateTime?
  deletedByProviderEventId String?
  // Edicion de un mensaje INBOUND (WhatsApp permite al cliente editar un
  // mensaje ya enviado; YCloud reenvia esto como un evento con
  // whatsappInboundMessage.type = 'edit'). Guardamos el texto original la
  // primera vez que se edita, para conservar el historial.
  editedAt                 DateTime?
  editedByProviderEventId  String?
  originalTextBody         String?
  // Reaccion (emoji) sobre este mensaje. WhatsApp la manda como un evento
  // aparte (type='reaction') referenciando el wamid de este mensaje, no
  // como un mensaje nuevo en el hilo. emoji=null significa sin reaccion
  // (o que la reaccion fue quitada: YCloud manda emoji='').
  reactionEmoji             String?
  reactedAt                 DateTime?
  reactedByProviderEventId  String?
  respondedAt              DateTime?
  responseToId             String?
  responseTo               Message?  @relation("MessageReplies", fields: [responseToId], references: [id], onDelete: SetNull)
  responses                Message[] @relation("MessageReplies")
  campaignKey              String?
  referralPayload          Json? // para guardar el referral payload de inbounds que vienen con referral (ejemplo: click en un anuncio)

  webhookEvents                      WebhookEvent[]
  statusHistory                      MessageStatusHistory[]
  leadCampaigns                      LeadCampaign[]
  conversationsAsLastMessage         Conversation[]         @relation("ConversationLastMessage")
  conversationsAsLastInboundMessage  Conversation[]         @relation("ConversationLastInboundMessage")
  conversationsAsLastOutboundMessage Conversation[]         @relation("ConversationLastOutboundMessage")
  mediaUploads                       MediaUpload[]
  designRequestAttachments           DesignRequestAttachment[] // ADR-004

  @@unique([accountId, ycloudMessageId])
  @@unique([accountId, clientRequestId])
  @@index([accountId, leadId, direction, createdAt])
  @@index([accountId, direction, type, providerCreateTime])
  @@index([accountId, templateName, providerCreateTime])
  @@index([templateName])
  @@index([wamid])
  @@index([accountId, externalId])
  @@index([accountId, wamid])
  @@index([leadId, createdAt])
  @@index([accountId, leadId, deletedAt])
  @@index([templateName, createdAt])
  @@index([externalId])
}

// Para manejar webhooks de YCloud u otros proveedores, y tener un historial de eventos
enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

model WebhookEvent {
  id              String             @id @default(uuid())
  provider        String
  eventType       String
  providerEventId String             @unique
  accountId       String?
  leadId          String?
  messageId       String?
  payload         Json
  status          WebhookEventStatus @default(PENDING)
  attempts        Int                @default(0)
  lastAttemptAt   DateTime?
  deadAt          DateTime?
  lastError       String?
  createdAt       DateTime           @default(now())
  processedAt     DateTime?

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  apiVersion   String?
  providerTime DateTime?
  routingKey   String?
  queueName    String?

  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@index([leadId, createdAt])
}

// Para tener un historial de cambios de estado de los mensajes (útil para debug, auditoría, métricas avanzadas, etc.)
model MessageStatusHistory {
  id              String         @id @default(uuid())
  messageId       String
  fromStatus      MessageStatus?
  toStatus        MessageStatus
  providerEventId String?
  providerTime    DateTime?
  payload         Json?
  createdAt       DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, toStatus, createdAt])
  @@index([messageId, createdAt])
  @@index([providerEventId])
}

enum CampaignDefinitionType {
  FIRST_CONTACT
  WEEK1_REENGAGEMENT
  REPETITION_REMINDER
}

enum CampaignDefinitionStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AccountCampaignTemplateStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  ERROR
}

enum LeadCampaignType {
  WEEK1_REENGAGEMENT
  REPETITION_REMINDER
  LABEL_RULE
}

enum LeadCampaignStatus {
  UNKNOWN
  PENDING
  ENQUEUED
  PROCESSING
  SENT
  SKIPPED
  FAILED
}

//Esta es la campaña global, que define la plantilla, el tipo de campaña, etc. Luego cada cuenta puede tener 0..N plantillas basadas en esta definición global, y cada lead puede estar asociado a una campaña concreta (basada en una plantilla concreta).
model CampaignDefinition {
  id       String                   @id @default(uuid())
  key      String                   @unique
  name     String
  type     CampaignDefinitionType
  language String
  category String?
  payload  Json
  version  Int                      @default(1)
  status   CampaignDefinitionStatus @default(ACTIVE)
  isActive Boolean                  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountTemplates AccountCampaignTemplate[]

  @@index([type, language])
  @@index([status, isActive])
}

//Esta tabla representa la materialización de una campaña global en una cuenta concreta. Es decir, una cuenta puede tener 0..N campañas basadas en la misma definición global (por ejemplo, una campaña de reengagement para cada idioma). Cada plantilla de campaña de cuenta puede estar asociada a múltiples leads (LeadCampaign) y a múltiples mensajes (Message).
model AccountCampaignTemplate {
  id String @id @default(uuid())

  accountId            String
  campaignDefinitionId String

  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  campaignDefinition CampaignDefinition @relation(fields: [campaignDefinitionId], references: [id], onDelete: Cascade)

  officialTemplateId String?
  wabaId             String
  name               String
  language           String

  category      String?
  qualityRating String?
  status        AccountCampaignTemplateStatus @default(DRAFT)
  statusDetail  String?

  ycloudCreateTime DateTime?
  ycloudUpdateTime DateTime?
  lastSyncedAt     DateTime?

  payloadSnapshot    Json?
  lastWebhookPayload Json?
  lastError          String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadCampaigns LeadCampaign[]

  @@unique([accountId, campaignDefinitionId])
  @@unique([accountId, officialTemplateId])
  @@index([accountId, status])
  @@index([campaignDefinitionId, status])
  @@index([wabaId])
}

enum AccountGlobalTemplateStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  IN_APPEAL
  ARCHIVED
  ERROR
}

// Plantilla de WhatsApp de gestion global: se crea una vez desde
// Configuracion y se replica en el WABA de cada comercial (ver
// GlobalWhatsappTemplateAccount). Independiente de CampaignDefinition,
// que es lo que ya usan las automatizaciones de reenganche/recordatorio.
model GlobalWhatsappTemplate {
  id       String @id @default(uuid())
  name     String
  language String
  category String
  // Los "components" (header/body/footer/botones) tal como se enviaron a YCloud.
  payload Json

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountTemplates GlobalWhatsappTemplateAccount[]

  @@unique([name, language])
  @@index([createdAt])
}

// Copia por comercial de una GlobalWhatsappTemplate, con su propio estado de
// aprobacion (cada WABA la aprueba/rechaza de forma independiente en Meta).
model GlobalWhatsappTemplateAccount {
  id String @id @default(uuid())

  globalTemplateId String
  globalTemplate   GlobalWhatsappTemplate @relation(fields: [globalTemplateId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  wabaId             String
  officialTemplateId String?
  status             AccountGlobalTemplateStatus @default(PENDING)
  statusDetail       String?

  lastWebhookPayload Json?
  lastSyncedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([globalTemplateId, accountId])
  @@index([wabaId])
  @@index([status])
}

// Regla configurable: "si un lead lleva N dias en esta etiqueta, mandale
// esta plantilla de WhatsApp". Ver ADR-002. Solo el rol SUPPORT puede crear
// o editar estas reglas (ver LabelMessageRulesController); ADMIN queda
// excluido a proposito de esta pantalla en particular, aunque hereda el
// resto de los permisos de ADMIN via ROLE_INHERITANCE.
model LabelMessageRule {
  id String @id @default(uuid())

  name String

  // Codigo de LeadLabelDefinition (catalogo global, de sistema o custom).
  labelCode String

  // Dias en la etiqueta (LeadLabelAssignment.assignedAt) antes de disparar.
  triggerAfterDays Int

  // "name" de un GlobalWhatsappTemplate: agrupa sus variantes por idioma,
  // que se resuelven en el envio segun el idioma del lead (igual que
  // reenganche: lead.preferredLanguage ?? resolveFromPhone(...)).
  templateName String

  active Boolean @default(true)

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, labelCode])
}

model LeadCampaign {
  id String @id @default(uuid())

  leadId     String
  accountId  String
  externalId String? @unique

  type   LeadCampaignType
  status LeadCampaignStatus @default(PENDING)

  businessWindowKey String

  sourceTemplateName String?
  targetTemplateName String?

  accountCampaignTemplateId String?
  messageId                 String?

  skipReason String?
  attempts   Int     @default(0)
  lastError  String?

  scheduledFor DateTime?
  enqueuedAt   DateTime?
  processedAt  DateTime?
  sentAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead                    Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  account                 Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountCampaignTemplate AccountCampaignTemplate? @relation(fields: [accountCampaignTemplateId], references: [id], onDelete: SetNull)
  message                 Message?                 @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([leadId, type, businessWindowKey])
  @@index([accountId, type, status, createdAt])
  @@index([accountCampaignTemplateId])
  @@index([messageId])
}

enum ProviderType {
  YCLOUD
}

enum MediaUploadStatus {
  UPLOADED
  ATTACHED
  FAILED
  EXPIRED
}

model MediaUpload {
  id String @id @default(uuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  provider        ProviderType @default(YCLOUD)
  providerMediaId String?
  originalName    String
  mimeType        String
  sizeBytes       Int

  mediaUrl           String?
  mediaStorageDriver String?
  mediaStorageKey    String?
  mediaExpiresAt     DateTime?

  status     MediaUploadStatus @default(UPLOADED)
  attachedAt DateTime?
  expiredAt  DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, status, createdAt])
  @@index([status, mediaExpiresAt])
  @@index([mediaStorageKey])
  @@index([providerMediaId])
}

model AccountProviderCredential {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  provider        ProviderType
  apiKeyEncrypted String
  apiKeyHint      String?
  isActive        Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, provider])
  @@index([provider, isActive])
}

model Conversation {
  id        String              @id @default(uuid())
  accountId String
  leadId    String
  channel   ConversationChannel @default(WHATSAPP)
  status    ConversationStatus  @default(OPEN)

  lastMessageId         String?
  lastInboundMessageId  String?
  lastOutboundMessageId String?

  lastMessageAt  DateTime?
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?

  customerWindowExpiresAt DateTime?
  isCustomerWindowOpen    Boolean   @default(false)

  requiresAttention Boolean @default(false)
  unreadCount       Int     @default(0)

  assignedUserId String?
  assignedAt     DateTime?
  closedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lastMessage         Message? @relation("ConversationLastMessage", fields: [lastMessageId], references: [id])
  lastInboundMessage  Message? @relation("ConversationLastInboundMessage", fields: [lastInboundMessageId], references: [id])
  lastOutboundMessage Message? @relation("ConversationLastOutboundMessage", fields: [lastOutboundMessageId], references: [id])

  @@unique([accountId, leadId, channel])
  @@index([accountId, status, lastMessageAt])
  @@index([accountId, requiresAttention, lastMessageAt])
  @@index([accountId, assignedUserId, lastMessageAt])
}

enum ConversationChannel {
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

// ==========================================
// Módulo de fichaje de horarios (time tracking)
// ==========================================

model Employee {
  id           String               @id @default(uuid())
  name         String
  contractType EmployeeContractType
  isActive     Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]

  @@index([isActive, name])
}

model TimeEntry {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  clockInAt        DateTime
  clockOutAt       DateTime?
  clockInByUserId  String?
  clockOutByUserId String?

  // calculado al fichar la salida
  totalMinutes Int? // duración real del turno, sin redondear

  // horas que se pagan: para contrato FIJO son solo las horas extra (>8h),
  // para contrato POR_HORAS son todas las horas trabajadas.
  // Fracciones >= 30 min cuentan como 1 hora completa; < 30 min no se pagan ni se redondean.
  payableHours Int?

  rateType    TimeEntryRateType?
  rateApplied Decimal?           @db.Decimal(10, 2)
  amount      Decimal?           @db.Decimal(10, 2)

  // true cuando totalMinutes supero el tope configurado (TimeTrackingRate.maxShiftMinutes)
  // y el pago se calculo sobre el tope, no sobre la duracion real. Sirve para
  // filtrar turnos que quedaron con el reloj corriendo y requieren revision manual.
  wasCapped Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, clockInAt])
  @@index([employeeId, clockOutAt])
  @@index([wasCapped])

  audits TimeEntryAudit[]
}

// Auditoria de ediciones manuales de un fichaje (hora entrada/salida) hechas
// por ADMIN o FACTORY_MANAGER desde "Mis horas". No se borra al eliminar el
// fichaje (onDelete: SetNull) -- solo se limpia con el purge total del
// modulo (TimeTrackingPurgeService), nunca con un delete normal de un fichaje.
// timeEntryId es opcional a proposito: al eliminar un fichaje normal
// (TimeEntriesService.removeEntry) la auditoria NO se borra (ON DELETE SET
// NULL), queda como registro huerfano para conservar el rastro de quien
// edito que. Solo se borra junto con el purge total del modulo
// (TimeTrackingPurgeService.purge).
model TimeEntryAudit {
  id          String     @id @default(uuid())
  timeEntryId String?
  timeEntry   TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)

  performedByUserId String
  performedByEmail  String

  previousClockInAt  DateTime
  previousClockOutAt DateTime?
  newClockInAt       DateTime
  newClockOutAt      DateTime?

  createdAt DateTime @default(now())

  @@index([timeEntryId])
}

model TimeTrackingRate {
  id String @id @default("default")

  overtimeWeekdayRate  Decimal @default(10) @db.Decimal(10, 2)
  overtimeSaturdayRate Decimal @default(15) @db.Decimal(10, 2)
  overtimeSundayRate   Decimal @default(18) @db.Decimal(10, 2)
  overtimeHolidayRate  Decimal @default(20) @db.Decimal(10, 2)
  hourlyRate           Decimal @default(8) @db.Decimal(10, 2)

  // Tope de duracion pagable por turno, para el caso del reloj dejado
  // corriendo. Si maxShiftEnabled es true y un turno supera maxShiftMinutes,
  // el pago se calcula solo hasta el tope y la entrada queda marcada
  // wasCapped=true para revision manual (ver TimeEntry.wasCapped).
  maxShiftEnabled Boolean @default(true)
  maxShiftMinutes Int     @default(720) // 12h por defecto

  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Calendario de festivos (nacionales, autonomicos o locales) que el modulo
// de fichaje usa para calcular horas extra a tarifa de festivo. Una sola
// fecha por registro; unique en date porque hoy Fenix opera con un unico
// calendario compartido (no hay Employee.region todavia).
model PublicHoliday {
  id     String       @id @default(uuid())
  date   DateTime     @db.Date
  name   String
  scope  HolidayScope @default(NATIONAL)
  region String? // solo aplica cuando scope = REGIONAL o LOCAL

  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
}


// =============================================================
// ADR-004: Modulo de solicitudes de bocetos (tablero tipo Jira)
// MVP core (Fase 0): tablero basico con 4 columnas fijas, SLA simple
// en dias corridos (sin dias habiles ni columna "Modificacion" todavia
// -- eso llega en submodulos posteriores, ver el ADR en el proyecto
// Fenix de Claude). Attachments: FROM_CHAT referencia un Message ya
// existente sin duplicar nada; UPLOADED guarda metadata de un archivo
// ya subido por otro endpoint (no se reinventa un pipeline de upload
// nuevo en el MVP).
// =============================================================

enum DesignRequestCountry {
  ES
  FR
  IT
  DE
}

enum DesignAttachmentKind {
  FROM_CHAT
  UPLOADED
}

model DesignBoard {
  id             String   @id @default(uuid())
  name           String
  defaultSlaDays Int      @default(3) // en dias habiles desde Submodulo 1 (ver ADR-004 SS7)
  slaCutoffHour  Int      @default(14) // 14:00 hora Europe/Madrid -- Submodulo 1
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  columns  DesignBoardColumn[]
  requests DesignRequest[]
}

model DesignBoardColumn {
  id      String      @id @default(uuid())
  boardId String
  board   DesignBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  code      String
  name      String
  sortOrder Int

  isInitial      Boolean @default(false)
  isModification Boolean @default(false) // Submodulo 4: columna "Modificacion" con plazo especial
  isFinal        Boolean @default(false)
  isApproved     Boolean @default(false)

  // Solo aplica si isModification=true: dias habiles del plazo especial
  // para las tarjetas que llegan aqui (por defecto 1, ver ADR-004 SS9.3).
  modificationSlaBusinessDays Int?

  active Boolean @default(true)

  requests         DesignRequest[]
  statusEventsTo   DesignRequestStatusEvent[] @relation("ToColumn")
  statusEventsFrom DesignRequestStatusEvent[] @relation("FromColumn")

  @@unique([boardId, code])
  @@unique([boardId, sortOrder])
  @@index([boardId, active, sortOrder])
}

model DesignRequest {
  id      String      @id @default(uuid())
  boardId String
  board   DesignBoard @relation(fields: [boardId], references: [id])

  columnId String
  column   DesignBoardColumn @relation(fields: [columnId], references: [id])

  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  title        String
  country      DesignRequestCountry @default(ES)
  instructions String?              @db.Text

  createdByUserId  String
  assignedUserId   String?
  assignedAt       DateTime?
  assignedByUserId String?

  slaBusinessDays       Int       @default(3) // Submodulo 1: dias habiles del plazo vigente
  dueAt                 DateTime
  overdueLabelAppliedAt DateTime? // Submodulo 1: evita reaplicar BOCETOS_ATRASADAS
  sentToModificationAt  DateTime? // Submodulo 4: ultima vez que entro a "Modificacion"

  // Submodulo 5: pausar/reanudar el plazo (solo DESIGNER_MANAGER/ADMIN).
  // Mientras pausedAt no es null, el semaforo se congela (se recalcula
  // usando pausedAt como "ahora" en vez de la hora real, ver
  // withSlaStatus()); al reanudar, dueAt se desplaza hacia adelante por el
  // tiempo real que estuvo pausada (ver ADR-004 SS4, nota de diseño).
  pausedAt       DateTime?
  pausedByUserId String?
  pausedTotalMs  BigInt    @default(0)

  completedAt           DateTime?
  approvedAt            DateTime?
  approvedViaLabel      Boolean   @default(false) // Submodulo 2: aprobada via etiqueta BOCETO_APROBADO

  archivedAt       DateTime? // Submodulo 8: "Marcar como hecho" desde Aprobados
  archivedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments  DesignRequestAttachment[]
  comments     DesignRequestComment[]
  statusEvents DesignRequestStatusEvent[]

  @@index([boardId, columnId])
  @@index([accountId, createdByUserId])
  @@index([assignedUserId])
  @@index([dueAt])
}

model DesignRequestAttachment {
  id              String         @id @default(uuid())
  designRequestId String?
  designRequest   DesignRequest? @relation(fields: [designRequestId], references: [id], onDelete: Cascade)

  // Submodulo 3: un adjunto puede colgar directo de la solicitud (al
  // crearla) o de un comentario (designRequestId queda null en ese caso).
  commentId String?
  comment   DesignRequestComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  kind DesignAttachmentKind

  sourceMessageId String?
  sourceMessage   Message? @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  mediaUrl        String?
  mediaStorageKey String?
  mimeType        String?
  fileName        String?
  sizeBytes       Int?

  uploadedByUserId  String
  forwardedToLeadAt DateTime?

  createdAt DateTime @default(now())

  @@index([designRequestId])
  @@index([commentId])
}

model DesignRequestComment {
  id              String        @id @default(uuid())
  designRequestId String
  designRequest   DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)

  authorUserId String
  body         String @db.Text

  attachments DesignRequestAttachment[] // Submodulo 3

  createdAt DateTime @default(now())

  @@index([designRequestId, createdAt])
}

model DesignRequestStatusEvent {
  id              String        @id @default(uuid())
  designRequestId String
  designRequest   DesignRequest @relation(fields: [designRequestId], references: [id], onDelete: Cascade)

  fromColumnId String?
  fromColumn   DesignBoardColumn? @relation("FromColumn", fields: [fromColumnId], references: [id])
  toColumnId   String
  toColumn     DesignBoardColumn  @relation("ToColumn", fields: [toColumnId], references: [id])

  direction       String
  changedByUserId String?
  changedAt       DateTime @default(now())

  @@index([designRequestId, changedAt])
}
